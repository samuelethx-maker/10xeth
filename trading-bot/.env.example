# Copy to .env (never commit it). Demo / paper accounts only.

# OANDA practice: GBPJPY, USDJPY, XAUUSD, XAGUSD, NAS100USD, US30
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# OANDA_API_URL=https://api-fxpractice.oanda.com

# Binance USD-M futures testnet: BTCUSDT, ETHUSDT
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_FUTURES_URL=https://testnet.binancefuture.com
# Conditional (stop/take-profit) order endpoint: algo (default) | classic (/fapi/v1/order)
# BINANCE_CONDITIONAL_API=algo

# IBKR paper (TWS 7497 / IB Gateway 4002): ES futures
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# Safety: adapters refuse non-demo endpoints/ports unless this is set to 1. Leave unset.
# ALLOW_LIVE=
